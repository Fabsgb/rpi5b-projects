# --- DEFAULTS ---
DEFAULT_KEYWORDS = ["admin", "login", "password", "api", "dashboard", "secret", "config", "contact", "db", "backup", "v1", "v2", "env"]
DEFAULT_BF_PATHS = ["admin", "login", "dashboard", "api", "config", "test", "dev", "staging", "backup", ".env", "phpmyadmin", "console", "server-status"]
DEFAULT_PROMPT_TEMPLATE = """You are a cybersecurity and web architecture analyzer.
Analyze the following web page data and determine its structural or security relevance.

URL: {url}
Title: {title}
H1: {h1}
Keywords Found: {keywords}
Content Preview: {content}

Provide a concise response in the following format:
RATING: [Score 1-10] | SUMMARY: [1-2 sentence description of what this page represents and why it is interesting]"""

def print_status(message: str) -> None:
    timestamp = time.strftime("%H:%M:%S")
    print(f"[{timestamp}] [STATUS] {message}")

def get_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Crawls a website and generates an interactive HTML report.")

    parser.add_argument("url", nargs="?", help="Start URL (e.g., https://example.com)")
    parser.add_argument("-mp", "--max-pages", type=int, default=200, help="Max pages to crawl")
    parser.add_argument("-md", "--max-depth", type=int, default=5, help="Max crawl depth")
    parser.add_argument("-to", "--timeout", type=float, default=8.0, help="Timeout per request in seconds")
    parser.add_argument("-mt", "--max-time", type=float, default=60.0, help="Max execution time in seconds")
    parser.add_argument("-ae", "--allow-external", action="store_true", help="Allow crawling external domains")
    parser.add_argument("-rr", "--respect-robots", action="store_true", help="Respect robots.txt rules")
    parser.add_argument("-an", "--analyse", choices=["none", "classic", "hybrid"], default="none", help="Analysis mode")
    parser.add_argument("-mo", "--model", type=str, default="", help="Ollama AI model name")
    parser.add_argument("-kw", "--keywords", type=str, default="", help="Path to CSV file with keywords")
    parser.add_argument("-pr", "--prompt", type=str, default="", help="Path to TXT file with custom AI prompt")
    parser.add_argument("-bf", "--brute-force", nargs="?", const="DEFAULT", default="", help="Enable brute-force mode")
    parser.add_argument("-hp", "--html-path", type=str, default="", help="Path for HTML report (Req. for classic/hybrid)")

    args = parser.parse_args()
    args.analyse = args.analyse.lower()

    if not args.url:
        args.url = input("No URL provided. Enter target URL (e.g., https://example.com): ").strip()

    if not urlparse(args.url).scheme:
        args.url = "https://" + args.url

    html_path_val = getattr(args, 'html_path', None)
    if not html_path_val:
        html_path_val = getattr(args, 'html-path', None)

    if args.analyse in ["classic", "hybrid"] and not html_path_val:
        print_status("ERROR: Flag '-hp / --html-path' is required when analysis mode is 'classic' or 'hybrid'.")
        sys.exit(1)

    args.html_path_final = html_path_val

    if args.analyse == "hybrid" and not args.model:
        print_status("ERROR: Flag '-mo / --model' is required when analysis mode is 'hybrid'.")
        sys.exit(1)

    return args

def load_keywords(csv_path: str) -> list:
    if not csv_path: return DEFAULT_KEYWORDS
    if not os.path.exists(csv_path):
        print_status(f"WARNING: Keyword file '{csv_path}' not found. Using defaults.")
        return DEFAULT_KEYWORDS

    keywords = []
    try:
        with open(csv_path, "r", encoding="utf-8") as f:
            for row in csv.reader(f):
                for item in row:
                    cleaned = item.strip().lower()
                    if cleaned: keywords.append(cleaned)
        print_status(f"Loaded {len(keywords)} keywords.")
        return keywords
    except Exception as e:
        print_status(f"ERROR reading CSV: {e}. Using defaults.")
        return DEFAULT_KEYWORDS

def load_prompt(txt_path: str) -> str:
    if not txt_path: return DEFAULT_PROMPT_TEMPLATE
    if not os.path.exists(txt_path): return DEFAULT_PROMPT_TEMPLATE
    try:
        with open(txt_path, "r", encoding="utf-8") as f:
            return f.read().strip()
    except:
        return DEFAULT_PROMPT_TEMPLATE

def load_bf_wordlist(bf_arg: str) -> list:
    if not bf_arg or bf_arg == "DEFAULT": return DEFAULT_BF_PATHS
    if not os.path.exists(bf_arg): return DEFAULT_BF_PATHS

    paths = []
    try:
        with open(bf_arg, "r", encoding="utf-8") as f:
            for row in csv.reader(f):
                for item in row:
                    cleaned = item.strip().lstrip("/")
                    if cleaned: paths.append(cleaned)
        print_status(f"Loaded {len(paths)} brute-force paths.")
        return paths
    except:
        return DEFAULT_BF_PATHS

def normalize_url(url: str) -> str:
    parsed = urlparse(url)
    path = parsed.path or "/"
    return f"{parsed.scheme}://{parsed.netloc}{path}"

def fetch_sitemap(start_url: str, session: requests.Session, timeout: float) -> list:
    parsed = urlparse(start_url)
    sitemap_url = f"{parsed.scheme}://{parsed.netloc}/sitemap.xml"
    urls = []
    try:
        resp = session.get(sitemap_url, timeout=timeout)
        if resp.status_code == 200 and "xml" in resp.headers.get("Content-Type", ""):
            root = ET.fromstring(resp.content)
            namespaces = {'ns': 'http://www.sitemaps.org/schemas/sitemap/0.9'}
            for loc in root.findall(".//ns:loc", namespaces) or root.findall(".//loc"):
                if loc.text: urls.append(normalize_url(loc.text.strip()))
            print_status(f"Extracted {len(urls)} URLs from sitemap.xml")
    except Exception as e:
        print_status(f"Sitemap check skipped/failed: {e}")
    return urls

def init_robots_parser(start_url: str, timeout: float) -> RobotFileParser:
    parsed = urlparse(start_url)
    robots_url = f"{parsed.scheme}://{parsed.netloc}/robots.txt"
    rp = RobotFileParser()
    rp.set_url(robots_url)
    try:
        rp.read()
        print_status("Parsed robots.txt")
    except:
        print_status("Could not read robots.txt")
    return rp

def analyze_classic_page(soup: BeautifulSoup, keywords: list, raw_html: str) -> dict:
    title = soup.title.string.strip() if soup.title and soup.title.string else "No Title"
    h1_tag = soup.find("h1")
    h1 = h1_tag.text.strip() if h1_tag else "No H1"

    text_content = soup.get_text(separator=" ", strip=True).lower()

    matched_keywords = {}
    for kw in keywords:
        # Regex: Matches word only if NOT surrounded by letters or numbers
        # Eliminates false positives like "capital" for "api" or base64 garbage
        pattern = re.compile(r'(?i)(?<![a-zA-Z0-9])' + re.escape(kw) + r'(?![a-zA-Z0-9])')

        if pattern.search(title):
            matched_keywords[kw] = f"Title matched: {title}"
            continue

        match = pattern.search(raw_html)
        if match:
            idx = match.start()
            start = max(0, idx - 40)
            end = min(len(raw_html), match.end() + 40)
            snippet = raw_html[start:end].replace('\n', ' ').replace('\r', ' ').strip()
            matched_keywords[kw] = f"... {snippet} ..."

    return {
        "title": title,
        "h1": h1,
        "keywords": matched_keywords,
        "is_interesting": len(matched_keywords) > 0,
        "snippet": text_content[:500],
        "ai_rating": None,
        "ai_summary": "Pending/Not analyzed"
    }

def run_ollama_analysis(data: dict, model: str, prompt_template: str) -> None:
    print_status("AI Phase started: Processing accumulated interesting pages via Ollama...")
    ollama_url = "http://localhost:11434/api/generate"

    interesting_items = [(url, info) for url, info in data.items() if info.get("is_interesting")]
    total_interesting = len(interesting_items)

    for idx, (url, info) in enumerate(interesting_items, start=1):
        print_status(f"[{idx}/{total_interesting}] Querying Ollama ({model}) for: {url}")

        kw_str = ", ".join(info.get("keywords", {}).keys())
        formatted_prompt = prompt_template.format(
            url=url, title=info.get("title", ""), h1=info.get("h1", ""),
            keywords=kw_str, content=info.get("snippet", "")
        )

        try:
            res = requests.post(ollama_url, json={"model": model, "prompt": formatted_prompt, "stream": False}, timeout=60.0)
            if res.status_code == 200:
                resp_text = res.json().get("response", "").strip()
                if "RATING:" in resp_text and "|" in resp_text:
                    parts = resp_text.split("|", 1)
                    info["ai_rating"] = parts[0].replace("RATING:", "").strip()
                    info["ai_summary"] = parts[1].replace("SUMMARY:", "").strip()
                else:
                    info["ai_summary"] = resp_text
                print_status(f"  └─ AI Result: Score={info['ai_rating']} | Summary={info['ai_summary'][:50]}...")
            else:
                info["ai_summary"] = f"Error (HTTP {res.status_code})"
        except Exception as e:
            info["ai_summary"] = f"Connection Error: {e}"

def build_terminal_tree(urls: set) -> dict:
    tree = {}
    for url in urls:
        parsed = urlparse(url)
        parts = [p for p in (parsed.netloc + parsed.path).split("/") if p]
        node = tree
        for part in parts:
            node = node.setdefault(part, {})
        node.setdefault("__leaf__", True)
    return tree

def print_terminal_tree(node: dict, prefix: str = "") -> None:
    keys = sorted(k for k in node.keys() if k != "__leaf__")
    for i, key in enumerate(keys):
        is_last = (i == len(keys) - 1)
        print(prefix + ("└── " if is_last else "├── ") + key)
        print_terminal_tree(node[key], prefix + ("    " if is_last else "│   "))


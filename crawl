def main():
    args = get_arguments()
    start_url = args.url
    start_domain = urlparse(start_url).netloc

    keywords = load_keywords(args.keywords)
    prompt_template = load_prompt(args.prompt)
    bf_wordlist = load_bf_wordlist(args.brute_force)

    print_status(f"Starting Crawl on: {start_url}")
    session = requests.Session()
    headers = {"User-Agent": "Mozilla/5.0 (compatible; LTCrawler/2.2)"}

    robots_parser = init_robots_parser(start_url, args.timeout) if args.respect_robots else None

    visited_data = {}
    queue = deque([(normalize_url(start_url), 0)])

    for surl in fetch_sitemap(start_url, session, args.timeout):
        if args.allow_external or urlparse(surl).netloc == start_domain:
            queue.append((surl, 1))

    start_time = time.time()

    print_status("Phase 1: Starting BFS Crawling...")
    while queue and len(visited_data) < args.max_pages:
        if time.time() - start_time > args.max_time:
            print_status("Max time reached.")
            break

        url, depth = queue.popleft()

        if url in visited_data or depth > args.max_depth:
            continue

        if robots_parser and not robots_parser.can_fetch(headers["User-Agent"], url):
            continue

        try:
            resp = session.get(url, headers=headers, timeout=args.timeout)
            if resp.status_code != 200 or "text/html" not in resp.headers.get("Content-Type", ""):
                continue
        except requests.RequestException:
            continue

        soup = BeautifulSoup(resp.text, "html.parser")

        if args.analyse in ["classic", "hybrid"]:
            page_info = analyze_classic_page(soup, keywords, resp.text)
        else:
            page_info = {"is_interesting": False}

        visited_data[url] = page_info
        print_status(f"[{len(visited_data)}/{args.max_pages}] Crawled: {url}")

        for tag in soup.find_all("a", href=True):
            href = tag["href"].strip()
            if href.startswith(("mailto:", "tel:", "javascript:")): continue
            abs_url = normalize_url(urljoin(url, href))

            if not args.allow_external and urlparse(abs_url).netloc != start_domain: continue
            if abs_url not in visited_data: queue.append((abs_url, depth + 1))

    if args.brute_force and len(visited_data) < args.max_pages:
        print_status("Phase 1.5: Brute-Force discovery...")
        for path in bf_wordlist:
            if len(visited_data) >= args.max_pages or (time.time() - start_time > args.max_time): break
            bf_url = normalize_url(f"https://{start_domain}/{path}")
            if bf_url in visited_data: continue

            print_status(f"Brute-Forcing: {bf_url}")
            try:
                resp = session.get(bf_url, headers=headers, timeout=args.timeout)
                if resp.status_code == 200 and "text/html" in resp.headers.get("Content-Type", ""):
                    print_status(f"  └─ Found: {bf_url}")
                    soup = BeautifulSoup(resp.text, "html.parser")
                    visited_data[bf_url] = analyze_classic_page(soup, keywords, resp.text) if args.analyse in ["classic", "hybrid"] else {"is_interesting": False}
                    for tag in soup.find_all("a", href=True):
                        href = tag["href"].strip()
                        if not href.startswith(("mailto:", "tel:", "javascript:")):
                            abs_url = normalize_url(urljoin(bf_url, href))
                            if args.allow_external or urlparse(abs_url).netloc == start_domain:
                                if abs_url not in visited_data: queue.append((abs_url, 1))
            except requests.RequestException: continue

    if args.analyse == "hybrid":
        run_ollama_analysis(visited_data, args.model, prompt_template)

    if args.analyse == "none" and not args.html_path_final:
        tree = build_terminal_tree(set(visited_data.keys()))
        print_terminal_tree(tree)
    else:
        generate_output_files(args.html_path_final, visited_data, start_url)

    print_status("Done.")

if __name__ == "__main__":
